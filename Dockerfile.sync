# syntax=docker/dockerfile:1

FROM node:26-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY db ./db
COPY scripts ./scripts
RUN mkdir -p /app/logs
# Load the sync entrypoint and every local import without contacting the DB or sources.
RUN npx tsx scripts/sync-internships.ts --help >/dev/null

# Persist the latest log, archive successful runs, and preserve sync failures.
CMD ["sh", "scripts/run-sync.sh"]
